<mxfile host="app.diagrams.net" modified="2026-10-18T18:00:00.000Z" agent="CatchAndGo" version="22.1.0">
  <diagram id="ExecutiveMessagingArchitecture" name="Arquitectura Ejecutiva de Mensajeria">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITULO EJECUTIVO -->
        <mxCell id="title" value="ARQUITECTURA DE INTEGRACIÓN Y MENSAJERÍA — CATCH &amp; GO" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="250" y="25" width="800" height="35" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Patrones de Integración: Comunicación Síncrona (Request-Reply / OpenFeign) y Asíncrona (Event-Driven / Redis Streams Broker)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="250" y="55" width="800" height="25" as="geometry" />
        </mxCell>

        <!-- CAPA CLIENTE / CANAL DE ENTRADA -->
        <mxCell id="client_box" value="&lt;b&gt;CAPA DE ACCESO&lt;/b&gt;&#xa;Frontend Web (React)&#xa;&amp; App Móvil (Android)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="150" height="110" as="geometry" />
        </mxCell>

        <!-- API GATEWAY -->
        <mxCell id="gateway_box" value="&lt;b&gt;API GATEWAY&lt;/b&gt;&#xa;Spring Cloud Gateway&#xa;(Railway Cloud :8080)&#xa;--------------------&#xa;Enrutamiento Centralizado&#xa;Seguridad &amp; CORS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="305" width="170" height="140" as="geometry" />
        </mxCell>

        <mxCell id="edge_client_gw" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="client_box" target="gateway_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========================================== -->
        <!-- BLOQUE SÍNCRONO (REQUEST-REPLY) -->
        <!-- ========================================== -->
        <mxCell id="sync_lane" value="CANAL SÍNCRONO — Consistencia Inmediata en Tiempo Real (Request-Reply Bloqueante)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#15803D;fontStyle=1;fontSize=12;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="470" y="110" width="770" height="220" as="geometry" />
        </mxCell>

        <mxCell id="match_box" value="&lt;b&gt;matching-service (:8084)&lt;/b&gt;&#xa;Motor de Afinidad Laboral&#xa;-----------------------&#xa;• Endpoint /matching/verify/{id}&#xa;• Orquestación de cálculo&#xa;• Medición de latencia (ms)&#xa;• Fallback de resiliencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#0F172A;align=left;spacingLeft=10;" vertex="1" parent="sync_lane">
          <mxGeometry x="30" y="45" width="210" height="150" as="geometry" />
        </mxCell>

        <mxCell id="feign_box" value="&lt;b&gt;Spring Cloud OpenFeign&lt;/b&gt;&#xa;Cliente HTTP Declarativo&#xa;-----------------------&#xa;GET /profiles/user/{userId}&#xa;Bloqueante Punto a Punto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontSize=11;" vertex="1" parent="sync_lane">
          <mxGeometry x="280" y="70" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="profile_box" value="&lt;b&gt;profile-service (:8082)&lt;/b&gt;&#xa;Gestión de Perfiles y Habilidades&#xa;-----------------------&#xa;• Endpoint /profiles/user/{id}&#xa;• Consulta relacional PostgreSQL&#xa;• Retorna skills y datos clave&#xa;• Latencia &lt; 50 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#0F172A;align=left;spacingLeft=10;" vertex="1" parent="sync_lane">
          <mxGeometry x="520" y="45" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- Conexiones Síncronas -->
        <mxCell id="edge_gw_match" value="GET /matching/verify/{id}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;fontColor=#15803D;" edge="1" parent="1" source="gateway_box" target="match_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="340" />
              <mxPoint x="430" y="230" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="edge_m_feign" value="Invocación" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#CA8A04;strokeWidth=2;" edge="1" parent="sync_lane" source="match_box" target="feign_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_feign_prof" value="Llamada HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="sync_lane" source="feign_box" target="profile_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_prof_return" value="Respuesta JSON Perfil (inmediata)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;fontColor=#047857;" edge="1" parent="sync_lane" source="profile_box" target="match_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="630" y="205" />
              <mxPoint x="135" y="205" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ========================================== -->
        <!-- BLOQUE ASÍNCRONO (EVENT-DRIVEN / BROKER) -->
        <!-- ========================================== -->
        <mxCell id="async_lane" value="CANAL ASÍNCRONO — Desacoplamiento &amp; Resiliencia (Event-Driven Message Broker)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;fontColor=#6B21A8;fontStyle=1;fontSize=12;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="470" y="360" width="770" height="460" as="geometry" />
        </mxCell>

        <mxCell id="jobs_box" value="&lt;b&gt;jobs-service (:8083)&lt;/b&gt;&#xa;Publicador Durable de Empleo&#xa;-----------------------&#xa;• POST /jobs/{id}/apply&#xa;• JobApplicationStreamPublisher&#xa;• Publicación con XADD&#xa;• Respuesta al cliente en &lt; 10ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;fontColor=#0F172A;align=left;spacingLeft=10;" vertex="1" parent="async_lane">
          <mxGeometry x="30" y="40" width="210" height="150" as="geometry" />
        </mxCell>

        <mxCell id="broker_box" value="&lt;b&gt;MESSAGE BROKER&lt;/b&gt;&#xa;Redis Streams 7 (Cloud/Local)&#xa;-----------------------&#xa;&lt;b&gt;stream:job-applications&lt;/b&gt;&#xa;• Log estructurado persistente&#xa;• Consumer Group: notification-group&#xa;• Pending Entries List (PEL)&#xa;• Retención MAXLEN ~ 10.000" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=11;" vertex="1" parent="async_lane">
          <mxGeometry x="280" y="35" width="200" height="160" as="geometry" />
        </mxCell>

        <mxCell id="notif_box" value="&lt;b&gt;notification-service (:8085)&lt;/b&gt;&#xa;Consumidor Concurrente&#xa;-----------------------&#xa;• JobApplicationStreamConsumer&#xa;• Procesa postulación en background&#xa;• Envío por WebSocket a candidato&#xa;• Confirmación manual XACK&#xa;• Ruteo a DLQ ante 3 reintentos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;fontColor=#0F172A;align=left;spacingLeft=10;" vertex="1" parent="async_lane">
          <mxGeometry x="520" y="40" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- DEAD LETTER QUEUE -->
        <mxCell id="dlq_box" value="&lt;b&gt;DEAD LETTER QUEUE (DLQ)&lt;/b&gt;&#xa;&lt;b&gt;stream:job-applications:dlq&lt;/b&gt;&#xa;Almacenamiento de mensajes fallidos con trazabilidad de error.&#xa;Aísla mensajes corruptos (Poison Pills) y garantiza cero pérdida." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=11;" vertex="1" parent="async_lane">
          <mxGeometry x="380" y="235" width="360" height="75" as="geometry" />
        </mxCell>

        <!-- GESTION DE COLAS -->
        <mxCell id="admin_box" value="&lt;b&gt;MÓDULO DE GESTIÓN Y MONITOREO DE COLAS&lt;/b&gt;&#xa;QueueAdminController (REST API en Gateway)&#xa;• GET /queues (Auditoría de colas, longitud y consumidores)&#xa;• POST /queues (Creación con Bean Validation @Valid @NotBlank) -&gt; 400 Bad Request ante entrada errónea&#xa;• GET /queues/{name}/dlq (Inspección de mensajes muertos para remediación)&#xa;• DELETE /queues/{name} (Baja de cola y grupos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;fontColor=#0F172A;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="async_lane">
          <mxGeometry x="30" y="335" width="710" height="105" as="geometry" />
        </mxCell>

        <!-- Conexiones Asíncronas -->
        <mxCell id="edge_gw_jobs" value="POST /jobs/{id}/apply" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;strokeWidth=2;fontColor=#7E22CE;" edge="1" parent="1" source="gateway_box" target="jobs_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="410" />
              <mxPoint x="430" y="475" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="edge_jobs_broker" value="XADD&#xa;(Evento Durable)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EA580C;strokeWidth=2;fontColor=#C2410C;" edge="1" parent="async_lane" source="jobs_box" target="broker_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_broker_notif" value="XREADGROUP&#xa;(Asíncrono)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#65A30D;strokeWidth=2;fontColor=#4D7C0F;" edge="1" parent="async_lane" source="broker_box" target="notif_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_notif_ack" value="XACK Manual (Confirmación de Procesamiento)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;dashed=1;fontColor=#15803D;" edge="1" parent="async_lane" source="notif_box" target="broker_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="630" y="210" />
              <mxPoint x="380" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="edge_notif_dlq" value="Desvío ante fallos recurrentes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=2;dashed=1;fontColor=#B91C1C;" edge="1" parent="async_lane" source="notif_box" target="dlq_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="630" y="220" />
              <mxPoint x="560" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="edge_admin_broker" value="Inspección y Administración" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;dashed=1;" edge="1" parent="async_lane" source="admin_box" target="broker_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="335" />
              <mxPoint x="320" y="195" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
