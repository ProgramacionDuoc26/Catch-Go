{
  "info": {
    "_postman_id": "b3e2d1a0-9c8f-4e1b-8765-ca7c4d020026",
    "name": "Catch & Go - EP5 Redis Streams",
    "description": "Colección para probar la implementación actual con Redis Streams. Consulta Documentacion/Guia_EP5_Streams_CatchAndGo.md. Configura los JWT internos y los identificadores en un entorno local de Postman; no guardes ni compartas credenciales. La colección no demuestra por sí sola la recepción de notificaciones o la ejecución de las pruebas de integración.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "URL del API Gateway."
    },
    {
      "key": "workerToken",
      "value": "",
      "type": "string",
      "description": "JWT interno del trabajador de prueba."
    },
    {
      "key": "companyToken",
      "value": "",
      "type": "string",
      "description": "JWT interno de la empresa de prueba."
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string",
      "description": "JWT interno de una cuenta ADMIN existente."
    },
    {
      "key": "workerId",
      "value": "",
      "type": "string",
      "description": "Identificador del trabajador, correspondiente al token."
    },
    {
      "key": "jobId",
      "value": "",
      "type": "string",
      "description": "Identificador de una oferta de prueba existente."
    },
    {
      "key": "applicationId",
      "value": "",
      "type": "string",
      "description": "ID de la postulación creada."
    },
    {
      "key": "demoStream",
      "value": "ep5-demo",
      "type": "string",
      "description": "Nombre exclusivo del stream de prueba."
    },
    {
      "key": "demoGroup",
      "value": "grupo-ep5",
      "type": "string",
      "description": "Nombre del grupo adicional de prueba."
    }
  ],
  "item": [
    {
      "name": "1. Consulta síncrona",
      "description": "Consulta mediante OpenFeign. Un FALLBACK indica que el perfil no se pudo obtener.",
      "item": [
        {
          "name": "Consultar perfil por matching",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/matching/verify/{{workerId}}",
            "description": "Usa el JWT interno del trabajador y un ID existente.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{workerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Streams de postulaciones",
      "description": "Usar una base de datos y cuentas de prueba. Las operaciones modifican datos; observar las notificaciones en la aplicación.",
      "item": [
        {
          "name": "1. Postular a una oferta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/jobs/{{jobId}}/apply?userId={{workerId}}",
            "description": "Guarda la postulación y el evento en el outbox; el stream se publica de forma posterior. No requiere cuerpo JSON.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{workerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Consultar postulaciones del trabajador",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/jobs/applications/user/{{workerId}}",
            "description": "Buscar la postulación creada y copiar su campo id en applicationId.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{workerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. Cambiar estado de la postulación",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/jobs/applications/{{applicationId}}/status",
            "description": "Cambia el estado y encola el evento de estado; usar el token de la empresa de prueba.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{companyToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACEPTADO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Inspección de streams y DLQ",
      "description": "Todas las solicitudes requieren JWT interno con rol ADMIN.",
      "item": [
        {
          "name": "Listar streams",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/queues",
            "description": "Muestra los streams y sus datos de resumen.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Grupos del stream de postulaciones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/queues/job-applications/groups",
            "description": "Revisar notifications-group, sus consumidores, pendientes y lag.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Grupos del stream de estados",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/queues/application-status/groups",
            "description": "Revisar application-status-notifications, sus consumidores, pendientes y lag.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Retención de postulaciones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/queues/job-applications/retention",
            "description": "Consultar la longitud objetivo; puede superarse para conservar mensajes necesarios.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Retención de estados",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/queues/application-status/retention",
            "description": "Consultar la longitud objetivo para el segundo stream.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "DLQ de postulaciones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/queues/job-applications/dlq",
            "description": "Consultar errores. Puede incluir un registro de inicialización.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "DLQ de estados",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/queues/application-status/dlq",
            "description": "Consultar errores. Puede incluir un registro de inicialización.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Administración con datos de prueba",
      "description": "Crear recursos aislados. Eliminar un stream borra su contenido y su DLQ; no usar nombres de producción.",
      "item": [
        {
          "name": "Crear stream de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/queues",
            "description": "Crea el stream, un grupo inicial y una DLQ. La respuesta esperada es 201.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{demoStream}}\",\n  \"consumerGroup\": \"grupo-inicial\",\n  \"maxLen\": 5000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Crear grupo adicional",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/queues/{{demoStream}}/groups",
            "description": "Crea un grupo desde 0-0. La respuesta esperada es 204.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{demoGroup}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Consultar grupos de prueba",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/queues/{{demoStream}}/groups",
            "description": "Revisar pendientes y consumidores antes de modificar el grupo.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cambiar retención de prueba",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/queues/{{demoStream}}/retention",
            "description": "Ajusta el objetivo de longitud. La política se aplica al publicar en los streams de negocio.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maxLen\": 250\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Reiniciar lectura de grupo de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/queues/{{demoStream}}/groups/{{demoGroup}}/replay",
            "description": "Puede repetir eventos retenidos; rechaza grupos protegidos y grupos con pendientes o consumidores registrados.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Eliminar grupo de prueba",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/queues/{{demoStream}}/groups/{{demoGroup}}",
            "description": "Puede responder 409 si hay mensajes sin leer, pendientes o consumidores registrados; el marcador de inicialización cuenta como entrada.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Eliminar stream de prueba",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/queues/{{demoStream}}",
            "description": "Elimina el stream y su DLQ. Ejecutar solo después de comprobar el nombre y que los datos sean descartables.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
